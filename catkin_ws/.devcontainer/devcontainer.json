{
  "name": "ROS Noetic Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/home/ros/catkin_ws",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "bash",
        "python.analysis.extraPaths": [
          "/opt/ros/noetic/lib/python3/dist-packages",
          "/home/ros/catkin_ws/devel/lib/python3/dist-packages"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools"
      ]
    }
  },
  "runArgs": ["-p", "8000:8000"],
  "forwardPorts": [11311, 8000],
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/ros/catkin_ws,type=bind"
  ],
  "remoteUser": "root"
}
